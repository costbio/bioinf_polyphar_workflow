#!/usr/bin/env python3
"""Host-side pocket-detection worker for polyphar: DoGSite3 (default) or DoGSiteScorer 2.

Both tools are licensed for the host, so they never run inside the polyphar container.
`polyphar pockets` (in the container) writes job files into <run>/04_pockets/queue/;
this script, run on the host, claims and runs them. It needs only Python >= 3.8 and its
standard library (it does not import polyphar).

Tool (--tool, default $POLYPHAR_POCKET_TOOL or dogsite3) and command line:
  dogsite3   <bin> -p <model> -o <out> -s -d --writeSiteResiduesPDB -v 1
             (<out>_desc.txt, <out>_P_<n>[_<m>]_res.pdb)
  dogsite2   <bin> -p <model> -s -i -y -d -w 4 -o <out>
             (<out>_desc.txt, <out>_res_P_<n>[_<m>].pdb)
Every job file names its tool (a job without one is from a DoGSiteScorer 2 era stage); a
job for another tool than this worker's is recorded as failed, never run with the wrong
binary.

Queue protocol (paths in job files are relative to the run folder):
  <id>.job                    {"model": ..., "out": ..., "size": <bytes>, "tool": ...}
  <id>.running.<host>.<pid>   claimed by os.rename (atomic): no job is run twice
  <id>.done                   {"exit": 0, "seconds": s, "dogsite_sha256": ..., "tool": ...,
                               "tool_version": ...}
  <id>.failed                 {"exit": n, "stderr_tail": ...} (+ "reason" for a timeout)
  WORKER.<host>.<pid>         heartbeat, touched every 30 s while the worker lives (mtime set
                              explicitly to this host's time.time(), also on NFS)
  CLOSED                      written by the container when every job is done or failed
"""

import argparse
import concurrent.futures
import glob
import hashlib
import json
import os
import platform
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
from datetime import datetime

QUEUE_REL = os.path.join("04_pockets", "queue")
POLL_S = 5.0
HEARTBEAT_S = 30.0
STALE_HEARTBEAT_S = 120.0     # a claim whose worker heartbeat is older than this is stale
DEFAULT_PREFLIGHT_TIMEOUT = 600.0
DEFAULT_JOB_TIMEOUT = 6 * 3600.0
LOG_REL = os.path.join("logs", "dogsite-worker.log")
TOOLS = ("dogsite3", "dogsite2")
DEFAULT_TOOL = "dogsite3"
LEGACY_TOOL = "dogsite2"      # a job file without a "tool" field
TOOL_ENV = "POLYPHAR_POCKET_TOOL"
DOGSITE2_FLAGS = ["-s", "-i", "-y", "-d", "-w", "4"]
# -s: subpockets, as with DoGSiteScorer 2 (P_<n>_<m> rows and files); -d: write _desc.txt;
# --writeSiteResiduesPDB: <out>_P_<n>_res.pdb (complete residues, the PocketMatch input);
# -v 1: errors only.
DOGSITE3_FLAGS = ["-s", "-d", "--writeSiteResiduesPDB", "-v", "1"]
STDERR_TAIL = 2000
HINT = "license/installation problem — see README §Pocket detection (DoGSite3 / DoGSiteScorer)"
REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
BENCH_DIR = os.path.join(REPO, "polyphar", "data", "bench")
# The bench CHAINS (protein models) in BENCH_DIR, timed by --benchmark; the first one is
# also the preflight model. Other files in BENCH_DIR (pockets, ligands) are not chains.
BENCH_CHAINS = ["2mjw_B.pdb", "6l49_A.pdb", "5nmm_A.pdb"]
PREFLIGHT_MODEL = os.path.join(BENCH_DIR, BENCH_CHAINS[0])

EPILOG = """\
modes:
  default      run the jobs queued now (all with the same --tool), then exit
  --watch      keep polling every 5 s for new jobs until queue/CLOSED exists
               (bin/polyphar-docker starts the worker like this for `pockets` / `run`)
  --benchmark  time the tool on the bench chains (BENCH_CHAINS in this script, files
               in polyphar/data/bench/) and store
               pockets.seconds_per_unit (per byte, one process) with its "tool" in
               $POLYPHAR_HOME/calibration.json (default ~/.polyphar; an entry of the other
               tool is replaced); without --run-dir nothing else is done

First the binary must agree with --tool (from what it says about itself only: the Tool: line of
VERSION_INFO next to it, else its --help text); DoGSite3 must be confirmed, DoGSiteScorer 2
is refused only when the binary is DoGSite3. Then, before claiming any job, the worker runs
the binary once on polyphar/data/bench/2mjw_B.pdb (preflight, with --tool's command line),
which must exit 0 and write <out>_desc.txt and residue files named as --tool's are
(dogsite3 <out>_P_*_res.pdb, dogsite2 <out>_res_P_*.pdb). If any of this fails, or takes
longer than --preflight-timeout, it exits with status 3 and the reason, leaving every job
queued.

At start, claims of this host are put back in the queue when they are stale: their
process is gone, or their WORKER.<host>.<pid> heartbeat is missing or older than 120 s
(a reused pid after a reboot). On SIGTERM / SIGHUP / SIGINT, running DoGSiteScorer
processes are killed, their partial outputs removed and their jobs put back in the queue.
A job whose setup fails (e.g. its output directory cannot be created) is recorded as
failed; the worker goes on. A DoGSiteScorer run longer than --job-timeout (default 6 h)
is killed (its whole process group), its partial outputs removed and the job recorded
as failed (`timeout after N s`). Input files are never modified.

Log lines go to stdout and to <run>/logs/dogsite-worker.log; a broken stdout (closed
terminal, ssh drop) never stops the worker.

exit status: 0 ok (failed jobs are recorded in <id>.failed), 2 usage error,
             3 preflight / benchmark failure, 128+N killed by signal N
"""


class Stop(Exception):
    """Raised in the main thread by SIGTERM / SIGHUP / SIGINT."""

    def __init__(self, signum):
        Exception.__init__(self, signum)
        self.signum = signum


def _on_signal(signum, frame):
    raise Stop(signum)


STOP_SIGNALS = (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)


def install_signal_handlers():
    """SIGTERM, SIGHUP (ssh drop) and SIGINT stop the worker cleanly. SIGHUP / SIGINT
    stay ignored when they were ignored at start (nohup; background job of a script)."""
    for sig in STOP_SIGNALS:
        if sig == signal.SIGTERM or signal.getsignal(sig) is not signal.SIG_IGN:
            signal.signal(sig, _on_signal)


def _ignore(signum, frame):
    pass


def ignore_signals():
    """Ignore further stop signals during cleanup. A no-op handler, not SIG_IGN: an
    ignored disposition would be inherited by a DoGSiteScorer child started in the same
    instant, which then could not be stopped with SIGTERM."""
    for sig in STOP_SIGNALS:
        signal.signal(sig, _ignore)


LOG_FILE = None   # <run>/logs/dogsite-worker.log once a Worker serves a run folder


def log(msg):
    """One line to stdout and to the worker log file. Never raises: a broken stdout
    (EPIPE / EIO after an ssh drop) must not turn a finished job into a failure."""
    line = "%s dogsite-worker[%d]: %s\n" % (datetime.now().strftime("%H:%M:%S"),
                                            os.getpid(), msg)
    try:
        sys.stdout.write(line)
        sys.stdout.flush()
    except (OSError, ValueError):
        try:   # stop writing to it; also keeps the interpreter's exit flush quiet
            sys.stdout = open(os.devnull, "w")
        except OSError:
            pass
    if LOG_FILE:
        try:
            with open(LOG_FILE, "a", encoding="utf-8") as fh:
                fh.write(datetime.now().strftime("%Y-%m-%d ") + line)
        except OSError:
            pass


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def write_json(path, obj):
    """Write through a unique temp name in the same directory + os.replace."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path),
                               prefix="." + os.path.basename(path) + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(obj, fh)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def unlink(path):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def remove_outputs(out):
    """Delete every output of `-o out` (<out>_desc.txt, <out>_res_*.pdb, <out>_P_*_res.pdb,
    <out>.pml, ...): files in out's directory named <out name>_* or <out name>.*."""
    d, base = os.path.split(out)
    try:
        names = os.listdir(d)
    except FileNotFoundError:
        return
    for name in names:
        if name.startswith(base + "_") or name.startswith(base + "."):
            unlink(os.path.join(d, name))


def pid_alive(pid):
    if pid == os.getpid():
        return False   # a claim with our pid is from an earlier process of the same pid
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def dogsite_cmd(dogsite, model, out, tool=DEFAULT_TOOL):
    if tool == "dogsite3":
        return [dogsite, "-p", model, "-o", out] + DOGSITE3_FLAGS
    return [dogsite, "-p", model] + DOGSITE2_FLAGS + ["-o", out]


def out_for(path_without_ext, tool):
    """`-o` value for a model: dogsite2 kept the model's .pdb in its output names."""
    return path_without_ext + ".pdb" if tool == "dogsite2" else path_without_ext


RES_PATTERNS = {"dogsite3": "%s_P_*_res.pdb", "dogsite2": "%s_res_P_*.pdb"}
TOOL_NAMES = {"dogsite3": "DoGSite3", "dogsite2": "DoGSiteScorer 2"}


def _version_info(dogsite):
    """{key: value} of VERSION_INFO next to the binary (DoGSite3 installs one), or {}."""
    info = os.path.join(os.path.dirname(os.path.realpath(dogsite)), "VERSION_INFO")
    out = {}
    try:
        with open(info, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                key, sep, value = line.partition(":")
                if sep and value.strip():
                    out.setdefault(key.strip().lower(), value.strip())
    except OSError:
        pass
    return out


def _help_text(dogsite):
    try:
        r = subprocess.run([dogsite, "--help"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, universal_newlines=True,
                           errors="replace", timeout=60)
        return r.stdout or ""
    except (OSError, subprocess.SubprocessError):
        return ""


def binary_tool(dogsite):
    """Which tool the binary is, from what it says about itself only: the `Tool:` line of
    VERSION_INFO next to it, else its --help text (DoGSite3 names itself or lists its
    --writeSiteResiduesPDB option; DoGSiteScorer 2.0.0 lists `-i [ --druggability ]`, which
    DoGSite3 does not have, or names itself). None when it says neither."""
    named = _version_info(dogsite).get("tool", "").lower()
    if named in TOOLS:
        return named
    text = _help_text(dogsite)
    low = text.lower()
    if "dogsite3" in low or "--writesiteresiduespdb" in low:
        return "dogsite3"
    if "dogsitescorer" in low or "--druggability" in low:
        return "dogsite2"
    return None


def identity_problem(dogsite, tool):
    """Why `dogsite` must not run as `tool`, or None. dogsite3 must be confirmed; dogsite2 is
    refused only when the binary identifies itself as DoGSite3."""
    found = binary_tool(dogsite)
    if found is not None and found != tool:
        return "%s is %s: conflicts with --tool %s" % (dogsite, TOOL_NAMES[found], tool)
    if found is None and tool == "dogsite3":
        return ("cannot confirm that %s is DoGSite3 (no VERSION_INFO next to it naming dogsite3 "
                "and its --help does not look like DoGSite3): conflicts with --tool "
                "dogsite3" % dogsite)
    return None


def tool_version(dogsite):
    """The binary's version: `Version:` of VERSION_INFO next to it (DoGSite3 installs one),
    else the first x.y[.z] in its `--help` output, else "unknown"."""
    version = _version_info(dogsite).get("version")
    if version:
        return version
    m = re.search(r"\b[Vv]ersion\s*:?\s*(\d+(?:\.\d+)+)", _help_text(dogsite))
    return m.group(1) if m else "unknown"


def tail(text):
    return text[-STDERR_TAIL:]


# --- preflight / benchmark -------------------------------------------------------------

def killpg(proc, sig):
    try:
        os.killpg(proc.pid, sig)
    except OSError:
        pass


def run_once(dogsite, model, timeout, tool=DEFAULT_TOOL):
    """Run the tool on `model` in a temp dir, for at most `timeout` seconds.
    Returns (ok, seconds, message)."""
    tmpdir = tempfile.mkdtemp(prefix="polyphar-dogsite-")
    try:
        stem = os.path.splitext(os.path.basename(model))[0]
        out = out_for(os.path.join(tmpdir, stem), tool)
        t0 = time.monotonic()
        proc = subprocess.Popen(dogsite_cmd(dogsite, os.path.abspath(model), out, tool),
                                cwd=tmpdir,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                universal_newlines=True, errors="replace",
                                start_new_session=True)
        try:
            _, err = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            killpg(proc, signal.SIGKILL)
            _, err = proc.communicate()
            return False, time.monotonic() - t0, "timed out after %g s: %s" % (
                timeout, tail(err).strip())
        except BaseException:
            killpg(proc, signal.SIGKILL)
            proc.wait()
            raise
        seconds = time.monotonic() - t0
        ok = proc.returncode == 0 and os.path.isfile(out + "_desc.txt")
        if not ok and proc.returncode == 0:
            err += "\n(exit 0 but no _desc.txt written)"
        pattern = RES_PATTERNS[tool] % os.path.basename(out)
        if ok and not glob.glob(os.path.join(tmpdir, glob.escape(os.path.basename(out)))
                                + RES_PATTERNS[tool][2:]):
            ok = False   # e.g. the other tool's binary: its residue files are named otherwise
            err += "\n(exit 0 but no residue file %s written: is this %s?)" % (
                pattern, TOOL_NAMES[tool])
        return ok, seconds, "exit %d: %s" % (proc.returncode, tail(err).strip())
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def preflight_failed(model, err):
    sys.stderr.write("dogsite-worker: preflight on %s failed (%s)\n%s\n" % (model, err, HINT))
    return 3


def preflight(dogsite, timeout=DEFAULT_PREFLIGHT_TIMEOUT, tool=DEFAULT_TOOL):
    ok, seconds, err = run_once(dogsite, PREFLIGHT_MODEL, timeout, tool)
    if not ok:
        return preflight_failed(PREFLIGHT_MODEL, err)
    log("preflight ok (%s, %.1f s on %s)" % (tool, seconds, os.path.basename(PREFLIGHT_MODEL)))
    return 0


def polyphar_home():
    return os.environ.get("POLYPHAR_HOME") or os.path.join(os.path.expanduser("~"), ".polyphar")


def cpu_model():
    """Same as polyphar.eta._cpu_model."""
    try:
        with open("/proc/cpuinfo", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if line.lower().startswith("model name"):
                    return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return platform.processor() or platform.machine() or "unknown"


def save_calibration(seconds_per_unit, tool=DEFAULT_TOOL):
    """Fold one measurement into calibration.json's `pockets` entry, in the schema of
    polyphar.eta.Calibration (running mean, "tool" recorded); an entry of another tool
    (no "tool" field = dogsite2) is replaced, other stages' entries are kept."""
    home = polyphar_home()
    os.makedirs(home, exist_ok=True)
    path = os.path.join(home, "calibration.json")
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        if not isinstance(data, dict):
            data = {}
    except (OSError, ValueError):
        data = {}
    old = data.get("pockets")
    if isinstance(old, dict) and (old.get("tool") or LEGACY_TOOL) != tool:
        old = None   # never average two tools
    n, mean = 0, float(seconds_per_unit)
    if isinstance(old, dict):
        try:
            prev = float(old["seconds_per_unit"])
            if prev > 0:
                try:
                    n = max(1, int(old.get("n_observations", 1)))
                except (TypeError, ValueError):
                    n = 1
                mean = (prev * n + seconds_per_unit) / (n + 1)
        except (KeyError, TypeError, ValueError):
            n = 0
    data["pockets"] = {
        "seconds_per_unit": mean,
        "n_observations": n + 1,
        "nproc": os.cpu_count(),
        "cpu_model": cpu_model(),
        "updated": datetime.now().astimezone().isoformat(timespec="seconds"),
        "tool": tool,
    }
    fd, tmp = tempfile.mkstemp(dir=home, prefix=".calibration.json.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(json.dumps(data, indent=2, sort_keys=True) + "\n")
        os.replace(tmp, path)
    except BaseException:
        unlink(tmp)
        raise
    return path, data["pockets"]


def benchmark(dogsite, timeout=DEFAULT_PREFLIGHT_TIMEOUT, tool=DEFAULT_TOOL):
    """Time the tool (one process) on the bench chains; store seconds per byte."""
    models = [os.path.join(BENCH_DIR, name) for name in BENCH_CHAINS]
    missing = [m for m in models if not os.path.isfile(m)]
    if missing:
        sys.stderr.write("dogsite-worker: bench chain(s) missing: %s\n" % ", ".join(missing))
        return 3
    if sum(os.path.getsize(m) for m in models) == 0:
        sys.stderr.write("dogsite-worker: the bench chains %s are empty (0 bytes); cannot "
                         "calibrate per byte\n" % ", ".join(models))
        return 3
    total_s = total_b = 0.0
    for model in models:
        ok, seconds, err = run_once(dogsite, model, timeout, tool)
        if not ok:
            return preflight_failed(model, err)
        size = os.path.getsize(model)
        log("benchmark %s: %.2f s for %d bytes" % (os.path.basename(model), seconds, size))
        total_s += seconds
        total_b += size
    path, entry = save_calibration(total_s / total_b, tool)
    log("pockets calibrated (%s): %.3g s per byte -> %s" % (tool, entry["seconds_per_unit"],
                                                            path))
    return 0


# --- the queue --------------------------------------------------------------------------

class Worker:
    def __init__(self, run_dir, dogsite, nprocs, watch, job_timeout=DEFAULT_JOB_TIMEOUT,
                 tool=DEFAULT_TOOL):
        self.run_dir = os.path.realpath(run_dir)
        self.job_timeout = job_timeout
        self.qdir = os.path.join(self.run_dir, QUEUE_REL)
        self.dogsite = dogsite
        self.tool = tool
        self.version = tool_version(dogsite)
        self.sha = sha256_file(dogsite)
        self.nprocs = nprocs
        self.watch = watch
        self.host = socket.gethostname()
        self.pid = os.getpid()
        self.tag = "%s.%d" % (self.host, self.pid)
        self.heartbeat = os.path.join(self.qdir, "WORKER." + self.tag)
        self.lock = threading.Lock()
        self.procs = {}          # job id -> Popen, while DoGSiteScorer runs
        self.finished = set()    # claims whose .done / .failed is written
        self.stopping = False

    # -- paths --
    def resolve(self, rel):
        """Run-folder-relative path from a job file -> host path; never outside."""
        if not isinstance(rel, str) or not rel or os.path.isabs(rel):
            raise ValueError("path %r is outside the run folder" % (rel,))
        path = os.path.normpath(os.path.join(self.run_dir, rel))
        if not path.startswith(self.run_dir + os.sep):
            raise ValueError("path %r is outside the run folder" % (rel,))
        return path

    def q(self, name):
        return os.path.join(self.qdir, name)

    def touch_heartbeat(self):
        with open(self.heartbeat, "a"):
            pass
        # explicit times: utime(path, None) lets an NFS server stamp its own clock, while
        # the container compares heartbeats with this host's time.time()
        t = time.time()
        os.utime(self.heartbeat, (t, t))

    # -- claims --
    def worker_gone(self, host, pid):
        """True when worker <host>.<pid> of THIS host is certainly not running: its pid is
        dead, or its heartbeat is missing or older than STALE_HEARTBEAT_S (a live pid can
        be an unrelated process after a reboot or pid reuse)."""
        if host != self.host or not pid.isdigit():
            return False
        if not pid_alive(int(pid)):
            return True
        try:
            age = time.time() - os.stat(self.q("WORKER.%s.%s" % (host, pid))).st_mtime
        except FileNotFoundError:
            return True
        return age > STALE_HEARTBEAT_S

    def reclaim_stale(self):
        """Put back stale claims of this host; drop their heartbeats."""
        names = os.listdir(self.qdir)
        gone = {}
        for name in names:
            if ".running." in name:
                jid, rest = name.split(".running.", 1)
                host, _, pid = rest.rpartition(".")
                if (host, pid) not in gone:
                    gone[(host, pid)] = self.worker_gone(host, pid)
                if gone[(host, pid)]:
                    self.unclaim(jid, name)
                    log("reclaimed stale claim %s" % name)
        for name in names:
            if name.startswith("WORKER."):
                host, _, pid = name[len("WORKER."):].rpartition(".")
                if gone.get((host, pid)) or self.worker_gone(host, pid):
                    unlink(self.q(name))

    def unclaim(self, jid, running_name):
        """Running job back to the queue (or dropped, when it already has a result)."""
        if os.path.exists(self.q(jid + ".done")) or os.path.exists(self.q(jid + ".failed")):
            unlink(self.q(running_name))
            return
        try:
            with open(self.q(running_name)) as fh:
                out = self.resolve(json.load(fh)["out"])
            remove_outputs(out)   # an unconfirmed run's output must not look done
        except (OSError, ValueError, KeyError, TypeError):
            pass
        try:
            os.rename(self.q(running_name), self.q(jid + ".job"))
        except FileNotFoundError:
            pass

    def claim_next(self):
        for name in sorted(os.listdir(self.qdir)):
            if not name.endswith(".job") or name.startswith("."):
                continue
            jid = name[:-len(".job")]
            running = "%s.running.%s" % (jid, self.tag)
            try:
                os.rename(self.q(name), self.q(running))
            except FileNotFoundError:
                continue   # another worker was faster
            return jid, running
        return None

    # -- one job (in a pool thread) --
    def run_job(self, jid, running):
        """One job; any error of this job becomes its .failed, never a worker crash."""
        try:
            self._run_job(jid, running)
        except Exception as exc:
            if self.stopping or running in self.finished:
                return   # unclaimed by the main thread / already done: never .failed after .done
            self.finish(jid, running, ".failed",
                        {"exit": -1, "stderr_tail": "worker error: %s: %s"
                         % (type(exc).__name__, exc)})
            log("FAILED %s (%s: %s)" % (jid, type(exc).__name__, exc))

    def _run_job(self, jid, running):
        try:
            with open(self.q(running)) as fh:
                spec = json.load(fh)
            model = self.resolve(spec["model"])
            out = self.resolve(spec["out"])
            job_tool = spec.get("tool") or LEGACY_TOOL
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as exc:
            self.finish(jid, running, ".failed", {"exit": -1, "stderr_tail": "bad job: %s" % exc})
            return
        if job_tool != self.tool:
            reason = ("job is for %s, this worker runs %s (--tool); one pocket tool per run "
                      "folder" % (job_tool, self.tool))
            self.finish(jid, running, ".failed", {"exit": -1, "reason": reason,
                                                  "stderr_tail": ""})
            log("FAILED %s (%s)" % (jid, reason))
            return
        outdir = os.path.dirname(out)
        desc = out + "_desc.txt"
        os.makedirs(outdir, exist_ok=True)
        remove_outputs(out)   # the desc file is the done marker: start clean
        t0 = time.monotonic()
        with self.lock:
            if self.stopping:
                return
            try:
                proc = subprocess.Popen(dogsite_cmd(self.dogsite, model, out, self.tool),
                                        cwd=outdir,
                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                        universal_newlines=True, errors="replace",
                                        start_new_session=True)
            except OSError as exc:
                self.finish(jid, running, ".failed",
                            {"exit": -1, "stderr_tail": "cannot start DoGSiteScorer: %s" % exc})
                return
            self.procs[jid] = proc
        timed_out = False
        try:
            try:
                _, err = proc.communicate(timeout=self.job_timeout)
            except subprocess.TimeoutExpired:
                timed_out = True
                killpg(proc, signal.SIGKILL)   # the whole group: no orphan keeps writing
                _, err = proc.communicate()
        finally:
            with self.lock:
                self.procs.pop(jid, None)
        seconds = time.monotonic() - t0
        if timed_out and not self.stopping:
            remove_outputs(out)
            reason = "timeout after %g s" % self.job_timeout
            self.finish(jid, running, ".failed", {"exit": proc.returncode, "reason": reason,
                                                  "stderr_tail": tail(err or "")})
            log("FAILED %s (%s)" % (jid, reason))
            return
        if proc.returncode == 0 and os.path.isfile(desc):
            self.finish(jid, running, ".done",
                        {"exit": 0, "seconds": round(seconds, 3), "dogsite_sha256": self.sha,
                         "tool": self.tool, "tool_version": self.version})
            log("done %s (%.1f s)" % (jid, seconds))
            return
        if self.stopping:
            return   # killed by us: unclaimed by the main thread
        remove_outputs(out)
        if proc.returncode == 0:
            err += "\n(exit 0 but no %s written)" % os.path.basename(desc)
        self.finish(jid, running, ".failed", {"exit": proc.returncode, "stderr_tail": tail(err)})
        log("FAILED %s (exit %d)" % (jid, proc.returncode))

    def finish(self, jid, running, suffix, obj):
        write_json(self.q(jid + suffix), obj)
        self.finished.add(running)
        unlink(self.q(running))

    def kill_all(self):
        with self.lock:
            self.stopping = True
            procs = list(self.procs.values())
        for p in procs:
            killpg(p, signal.SIGTERM)
        deadline = time.monotonic() + 10
        for p in procs:
            try:
                p.wait(max(0.1, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                killpg(p, signal.SIGKILL)
                p.wait()

    # -- main loop --
    def loop(self):
        inflight = set()
        last_beat = 0.0
        with concurrent.futures.ThreadPoolExecutor(max_workers=self.nprocs) as ex:
            try:
                while True:
                    now = time.monotonic()
                    if now - last_beat >= HEARTBEAT_S:
                        self.touch_heartbeat()
                        last_beat = now
                    exhausted = False
                    while len(inflight) < self.nprocs:
                        c = self.claim_next()
                        if c is None:
                            exhausted = True
                            break
                        inflight.add(ex.submit(self.run_job, *c))
                    if inflight:
                        finished, inflight = concurrent.futures.wait(
                            inflight, timeout=1.0,
                            return_when=concurrent.futures.FIRST_COMPLETED)
                        for f in finished:
                            f.result()   # run_job handles DoGSiteScorer failures itself
                        continue
                    if exhausted and not self.watch:
                        return
                    if os.path.exists(self.q("CLOSED")):
                        log("queue closed")
                        return
                    time.sleep(POLL_S)
            except BaseException:
                ignore_signals()   # finish the cleanup even if signalled again
                self.kill_all()
                raise

    def unclaim_own(self):
        suffix = ".running." + self.tag
        for name in os.listdir(self.qdir):
            if name.endswith(suffix):
                self.unclaim(name[:-len(suffix)], name)

    def serve(self):
        global LOG_FILE
        os.makedirs(self.qdir, exist_ok=True)
        try:
            os.makedirs(os.path.join(self.run_dir, "logs"), exist_ok=True)
            LOG_FILE = os.path.join(self.run_dir, LOG_REL)
        except OSError:
            LOG_FILE = None
        self.reclaim_stale()
        self.touch_heartbeat()
        try:
            self.loop()
        finally:
            self.unclaim_own()
            unlink(self.heartbeat)
        return 0


def find_binary(value):
    if not value:
        return None
    if os.sep not in value:
        value = shutil.which(value) or value
    value = os.path.abspath(value)
    return value if os.path.isfile(value) and os.access(value, os.X_OK) else None


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="polyphar-dogsite-worker",
        description="Run the pocket-detection jobs (DoGSite3 or DoGSiteScorer 2) that "
                    "`polyphar pockets` queues in <run>/04_pockets/queue/ (host side; "
                    "Python >= 3.8, stdlib only).",
        epilog=EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--run-dir", help="the run folder on this host (required unless "
                                     "only --benchmark)")
    p.add_argument("--dogsite", default=os.environ.get("DOGSITE_BIN"),
                   help="the tool's binary, e.g. /opt/ZBH/dogsite3/dogsite3 (default: "
                        "$DOGSITE_BIN)")
    p.add_argument("--tool", default=os.environ.get(TOOL_ENV) or DEFAULT_TOOL,
                   help="dogsite3 or dogsite2: the tool --dogsite is (default: $%s or %s); "
                        "must be the run's --pocket-tool" % (TOOL_ENV, DEFAULT_TOOL))
    p.add_argument("--nprocs", type=int, default=4,
                   help="DoGSiteScorer processes at a time (default: 4)")
    p.add_argument("--watch", action="store_true",
                   help="keep polling for jobs until queue/CLOSED exists")
    p.add_argument("--benchmark", action="store_true",
                   help="calibrate pockets in $POLYPHAR_HOME/calibration.json")
    p.add_argument("--preflight-timeout", type=float, default=DEFAULT_PREFLIGHT_TIMEOUT,
                   help="seconds the preflight (and each benchmark run) may take "
                        "(default: %g)" % DEFAULT_PREFLIGHT_TIMEOUT)
    p.add_argument("--job-timeout", type=float, default=DEFAULT_JOB_TIMEOUT,
                   help="seconds one DoGSiteScorer job may take before it is killed and "
                        "recorded as failed (default: %g)" % DEFAULT_JOB_TIMEOUT)
    args = p.parse_args(argv)
    if not args.job_timeout > 0:
        p.error("--job-timeout must be > 0")
    if args.nprocs < 1:
        p.error("--nprocs must be >= 1")
    if not args.preflight_timeout > 0:
        p.error("--preflight-timeout must be > 0")
    if args.tool not in TOOLS:
        p.error("--tool / $%s must be one of %s (got %r)" % (TOOL_ENV, ", ".join(TOOLS),
                                                           args.tool))
    if not args.run_dir and not args.benchmark:
        p.error("--run-dir is required (unless --benchmark)")
    if args.run_dir and not os.path.isdir(args.run_dir):
        p.error("run dir %s does not exist" % args.run_dir)
    binary = find_binary(args.dogsite)
    if binary is None:
        p.error("DoGSiteScorer binary %r not found or not executable (--dogsite or "
                "$DOGSITE_BIN)" % (args.dogsite,))
    args.dogsite = binary
    return args


def main(argv=None):
    args = parse_args(argv)
    install_signal_handlers()
    try:
        problem = identity_problem(args.dogsite, args.tool)
        if problem:
            sys.stderr.write("dogsite-worker: %s; set DOGSITE_BIN / --dogsite to the %s binary "
                             "or choose the matching --tool / --pocket-tool\n"
                             % (problem, TOOL_NAMES[args.tool]))
            return 3
        if args.benchmark:
            status = benchmark(args.dogsite, args.preflight_timeout, args.tool)
        else:
            status = preflight(args.dogsite, args.preflight_timeout, args.tool)
        if status != 0 or not args.run_dir:
            return status
        return Worker(args.run_dir, args.dogsite, args.nprocs, args.watch,
                      args.job_timeout, args.tool).serve()
    except Stop as stop:
        log("stopped by signal %d" % stop.signum)
        return 128 + stop.signum


if __name__ == "__main__":
    sys.exit(main())
