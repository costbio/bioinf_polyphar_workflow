#!/usr/bin/env bash
# Host wrapper: run the polyphar CLI in its docker image, writing into the run folder.
#
#   bin/polyphar-docker [polyphar args...]
#
# Environment:
#   POLYPHAR_RUN_DIR      run folder on the host (default: current directory)
#   DOGSITE_BIN           host pocket-detection binary of the chosen tool (needed by
#                         pockets / run / benchmark), e.g. /opt/ZBH/dogsite3/dogsite3
#   POLYPHAR_POCKET_TOOL  dogsite3 (default) or dogsite2; a `--pocket-tool X` argument wins.
#                         The same tool goes to the host worker (--tool) and the container
#                         (env; the stage also writes it into every job file)
#   POLYPHAR_HOME         calibration / pushover.env dir (default: ~/.polyphar)
#   POLYPHAR_VERSION      image tag (default: latest)
#   NPROCS                worker processes (passed through)
#   POLYPHAR_PREFLIGHT_TIMEOUT  seconds the DoGSiteScorer preflight may take (default 600)
#   POLYPHAR_DOGSITE_JOB_TIMEOUT  seconds one DoGSiteScorer job may take before the worker
#                         kills it and records it as failed (default 21600 = 6 h)
#   POLYPHAR_DOCKER_OPTS  extra `docker run` options (word-split on purpose)
#
# The container runs in the foreground; for long runs use tmux or nohup.
set -euo pipefail

run_dir="$(realpath "${POLYPHAR_RUN_DIR:-$PWD}")"
if [ ! -d "$run_dir" ]; then
    echo "polyphar-docker: run dir $run_dir does not exist" >&2
    exit 2
fi
home_dir="${POLYPHAR_HOME:-$HOME/.polyphar}"
mkdir -p "$home_dir"
home_dir="$(realpath "$home_dir")"

# --- pocket tool: --pocket-tool X / --pocket-tool=X, else $POLYPHAR_POCKET_TOOL, else dogsite3
pocket_tool="${POLYPHAR_POCKET_TOOL:-dogsite3}"
prev=""
for a in "$@"; do
    if [ "$prev" = "--pocket-tool" ]; then
        pocket_tool="$a"
    fi
    case "$a" in
        --pocket-tool=*) pocket_tool="${a#--pocket-tool=}" ;;
    esac
    prev="$a"
done
case "$pocket_tool" in
    dogsite3|dogsite2) ;;
    *)
        echo "polyphar-docker: pocket tool must be dogsite3 or dogsite2 (got '$pocket_tool')" >&2
        exit 2 ;;
esac

opts=(--rm --init --user "$(id -u):$(id -g)"
      -v "$run_dir":/work
      -v "$home_dir":/polyphar_home
      -e NPROCS
      -e POLYPHAR_POCKET_TOOL="$pocket_tool"
      -e POLYPHAR_RUN_NAME="$(basename "$run_dir")")
if [ -f "$home_dir/pushover.env" ]; then
    opts+=(--env-file "$home_dir/pushover.env")
fi

image="polyphar:${POLYPHAR_VERSION:-latest}"

# --- DoGSiteScorer host worker -------------------------------------------------------
# DoGSiteScorer is licensed for the host and never runs in the container: the container
# queues jobs in 04_pockets/queue/ and bin/polyphar-dogsite-worker (host) runs them.
# The worker is started (--watch) for
#   pockets                             always
#   run [--from S] [--to S]             unless --to is a stage before pockets or --from
#                                       one after it (only `--from S`, `--from=S`,
#                                       `--to S`, `--to=S` are recognised; anything
#                                       else is assumed to include pockets)
# but not with --dry-run / --help. Its --nprocs is the polyphar `--nprocs N` /
# `--nprocs=N` argument if given, else $NPROCS, else 4 (the container's ETA uses the
# same value). The container starts only once the worker's preflight passed (its
# heartbeat appears), waiting at most POLYPHAR_PREFLIGHT_TIMEOUT + 60 s. The worker is
# stopped by a trap on EXIT/INT/TERM/HUP; the wrapper's exit status stays the container's.
# If the worker exits while the container runs and the queue is not CLOSED (pockets not
# finished), the wrapper says so and stops the container (SIGTERM: the run ends with its
# FAILED notification and summary) instead of letting pockets wait for a dead worker.
# Host calibration of pockets (worker --benchmark) runs before the container for
# `benchmark`, and for `run` (including pockets) when calibration.json has no pockets
# entry for this pocket tool yet (an entry without a tool is dogsite2's).
worker="$(dirname "$(realpath "$0")")/polyphar-dogsite-worker"
stage_index() {
    case "$1" in
        ids) echo 0 ;; uniprot) echo 1 ;; structures) echo 2 ;; fix) echo 3 ;;
        pockets) echo 4 ;; similarity) echo 5 ;; select) echo 6 ;; dock) echo 7 ;;
        *) echo "" ;;
    esac
}
preflight_timeout="${POLYPHAR_PREFLIGHT_TIMEOUT:-600}"
case "$preflight_timeout" in
    ''|*[!0-9]*|0)
        echo "polyphar-docker: POLYPHAR_PREFLIGHT_TIMEOUT must be a whole number of seconds > 0" >&2
        exit 2 ;;
esac
job_timeout="${POLYPHAR_DOGSITE_JOB_TIMEOUT:-21600}"
case "$job_timeout" in
    ''|*[!0-9]*|0)
        echo "polyphar-docker: POLYPHAR_DOGSITE_JOB_TIMEOUT must be a whole number of seconds > 0" >&2
        exit 2 ;;
esac
worker_nprocs="${NPROCS:-4}"
prev=""
for a in "$@"; do
    if [ "$prev" = "--nprocs" ]; then
        worker_nprocs="$a"
    fi
    case "$a" in
        --nprocs=*) worker_nprocs="${a#--nprocs=}" ;;
    esac
    prev="$a"
done
want_worker=0
want_bench=0
case "${1:-}" in
    pockets) want_worker=1 ;;
    benchmark) want_bench=1 ;;
    run)
        from=0 to=7 prev=""
        for a in "${@:2}"; do
            case "$prev" in
                --from) from="$(stage_index "$a")" ;;
                --to) to="$(stage_index "$a")" ;;
            esac
            case "$a" in
                --from=*) from="$(stage_index "${a#--from=}")" ;;
                --to=*) to="$(stage_index "${a#--to=}")" ;;
            esac
            prev="$a"
        done
        if [ "${from:-0}" -le 4 ] && [ "${to:-7}" -ge 4 ]; then
            want_worker=1
            if ! python3 - "$home_dir/calibration.json" "$pocket_tool" <<'PY' 2>/dev/null
import json, sys
entry = json.load(open(sys.argv[1])).get("pockets") or {}
same_tool = (entry.get("tool") or "dogsite2") == sys.argv[2]
sys.exit(0 if same_tool and float(entry.get("seconds_per_unit", 0)) > 0 else 1)
PY
            then
                want_bench=1
            fi
        fi
        ;;
esac
for a in "$@"; do
    case "$a" in
        --dry-run|-h|--help) want_worker=0 want_bench=0 ;;
    esac
done

if [ "$want_worker" = 0 ] && [ "$want_bench" = 0 ]; then
    # shellcheck disable=SC2086  # POLYPHAR_DOCKER_OPTS is intentionally word-split
    exec docker run "${opts[@]}" ${POLYPHAR_DOCKER_OPTS:-} "$image" "$@"
fi

if [ -z "${DOGSITE_BIN:-}" ]; then
    if [ "$want_worker" = 1 ]; then
        echo "polyphar-docker: DOGSITE_BIN is not set; pockets needs the host $pocket_tool" \
             "binary (export DOGSITE_BIN=/opt/ZBH/dogsite3/dogsite3 for dogsite3)" >&2
        exit 2
    fi
    echo "polyphar-docker: DOGSITE_BIN is not set; pockets is not calibrated (host only)" >&2
    want_bench=0
fi

if [ "$want_bench" = 1 ]; then
    bench_status=0
    POLYPHAR_HOME="$home_dir" "$worker" --benchmark --dogsite "$DOGSITE_BIN" \
        --tool "$pocket_tool" --preflight-timeout "$preflight_timeout" || bench_status=$?
    if [ "$bench_status" != 0 ]; then
        echo "polyphar-docker: DoGSiteScorer benchmark failed (exit $bench_status)" >&2
        if [ "$want_worker" = 1 ]; then
            exit "$bench_status"
        fi
    fi
fi

worker_pid=""
docker_pid=""
stop_worker() {
    if [ -n "$worker_pid" ]; then
        kill -TERM "$worker_pid" 2>/dev/null || true
        wait "$worker_pid" 2>/dev/null || true
        worker_pid=""
    fi
}
on_signal() {
    trap '' INT TERM HUP
    if [ -n "$docker_pid" ]; then
        kill -TERM "$docker_pid" 2>/dev/null || true
        wait "$docker_pid" 2>/dev/null || true
    fi
    exit $((128 + $1))   # the EXIT trap stops the worker
}
trap stop_worker EXIT
trap 'on_signal 2' INT
trap 'on_signal 15' TERM
trap 'on_signal 1' HUP

if [ "$want_worker" = 1 ]; then
    queue="$run_dir/04_pockets/queue"
    mkdir -p "$queue"
    rm -f "$queue/CLOSED"   # left by an earlier run; it would stop the new worker
    "$worker" --run-dir "$run_dir" --dogsite "$DOGSITE_BIN" --tool "$pocket_tool" \
        --nprocs "$worker_nprocs" --preflight-timeout "$preflight_timeout" \
        --job-timeout "$job_timeout" --watch &
    worker_pid=$!
    # The worker's heartbeat appears once its preflight passed.
    start_deadline=$((SECONDS + preflight_timeout + 60))
    until compgen -G "$queue/WORKER.*.$worker_pid" >/dev/null; do
        if [ "$SECONDS" -ge "$start_deadline" ]; then
            echo "polyphar-docker: the DoGSiteScorer worker did not pass its preflight within" \
                 "$((preflight_timeout + 60)) s; stopping it" >&2
            exit 1   # the EXIT trap stops the worker
        fi
        if ! kill -0 "$worker_pid" 2>/dev/null; then
            worker_status=0
            wait "$worker_pid" || worker_status=$?
            worker_pid=""
            echo "polyphar-docker: the DoGSiteScorer worker did not start" \
                 "(exit $worker_status)" >&2
            exit "$(( worker_status == 0 ? 1 : worker_status ))"
        fi
        sleep 0.2
    done
fi

# In the background so a signal to this wrapper is handled at once (forwarded to
# `docker run`, which passes it on to the container).
# shellcheck disable=SC2086  # POLYPHAR_DOCKER_OPTS is intentionally word-split
docker run "${opts[@]}" ${POLYPHAR_DOCKER_OPTS:-} "$image" "$@" &
docker_pid=$!
status=0
if [ -n "$worker_pid" ]; then
    # watch the worker while the container runs (signals interrupt the 1 s sleep)
    while kill -0 "$docker_pid" 2>/dev/null; do
        if [ -n "$worker_pid" ] && ! kill -0 "$worker_pid" 2>/dev/null; then
            worker_status=0
            wait "$worker_pid" || worker_status=$?
            worker_pid=""
            if [ ! -e "$queue/CLOSED" ]; then
                echo "polyphar-docker: the DoGSiteScorer worker exited (status $worker_status)" \
                     "before the pockets queue was closed; stopping the container" >&2
                kill -TERM "$docker_pid" 2>/dev/null || true
                wait "$docker_pid" || status=$?
                docker_pid=""
                exit "$(( status == 0 ? 1 : status ))"
            fi
        fi
        sleep 1 &
        wait $! || true
    done
fi
wait "$docker_pid" || status=$?
docker_pid=""
exit "$status"
