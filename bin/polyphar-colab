#!/usr/bin/env bash
# Host wrapper: one docking round trip on a Colab Pro+ GPU, end to end.
#
#   bin/polyphar-colab [--max-units N] [--session NAME] [--gpu L4] [--control] [--keep]
#                      [--library PATH]
#
# Does, in order: dock-export here -> create/reuse a Colab session -> upload the bundle
# and the Pushover credentials -> install the engine -> launch the detached worker -> poll
# until it finishes -> pack -> download -> dock-merge here.
#
# Re-run it until `dock` reports nothing outstanding: every stage underneath resumes, so a
# second run exports only what is still missing. A dropped session costs at most the units
# in flight.
#
# Environment:
#   POLYPHAR_RUN_DIR   run folder on the host (default: current directory)
#   POLYPHAR_HOME      calibration / pushover.env dir (default: ~/.polyphar)
#   POLYPHAR_VERSION   image tag, passed to polyphar-docker
#   POLYPHAR_REPO      checkout holding bin/colab (default: this script's repo)
#   COLAB_POLL_SECONDS seconds between progress polls (default 120)
#   POLYPHAR_MAX_UNITS units per session (default 200, ~20 h); --max-units wins
#   ALLOW_SILENT=1     start the worker even without Pushover credentials
#   POLYPHAR_COLAB_KEEP=1  do not stop the session at the end (same as --keep)
#
# Exits non-zero on any failure, so `&&` chains and tmux wrappers cannot mistake a dropped
# session for a finished one.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="${POLYPHAR_REPO:-$(cd "$here/.." && pwd)}"
run_dir="$(realpath "${POLYPHAR_RUN_DIR:-$PWD}")"
home_dir="$(realpath "${POLYPHAR_HOME:-$HOME/.polyphar}")"
poll_s="${COLAB_POLL_SECONDS:-120}"
# How long the client waits for the two one-shot cells. Generous on purpose for a
# production run -- a VM you have already waited ten minutes for is worth more than a
# fast failure -- but a test wants the opposite, so both are knobs.
setup_s="${COLAB_SETUP_TIMEOUT:-4200}"
launch_s="${COLAB_LAUNCH_TIMEOUT:-900}"

# 200 units is about 20 hours at ~6 GPU-minutes a unit: a session long enough to be worth
# the setup, short enough that losing it to a dropped VM is not a disaster.
max_units="${POLYPHAR_MAX_UNITS:-200}"
session="dock"; gpu="L4"; control=""
# POLYPHAR_COLAB_KEEP: leave the session up at the end. Several run folders docked one
# after another (the seven subtype tests, or a night of subtypes) otherwise pay the
# engine install -- micromamba, Uni-Dock, the pinned polyphar -- once per bundle instead
# of once per session.
keep="${POLYPHAR_COLAB_KEEP:+1}"
# the run's library, forwarded from polyphar-docker: dock-export and dock-merge must both
# see the same one, since its sha256 is part of every unit key
library=""
while [ $# -gt 0 ]; do
    case "$1" in
        --max-units) max_units="$2"; shift 2 ;;
        --session)   session="$2";   shift 2 ;;
        --gpu)       gpu="$2";       shift 2 ;;
        --control)   control="--control"; shift ;;
        --keep)      keep="1"; shift ;;
        --library)   library="$2"; shift 2 ;;
        -h|--help)   sed -n '2,24p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *) echo "polyphar-colab: unknown option $1" >&2; exit 2 ;;
    esac
done

say() { printf '\n== %s\n' "$*"; }
note() { printf '%s  %s\n' "$(date +%H:%M:%S)" "$*"; }

# `colab exec` streams the remote cell's stdout as it arrives (colab_cli's display_output
# writes and flushes every chunk), but `out="$(colab exec ...)"` holds all of it until the
# cell ends. setup.py prints each install command before running it, so the information
# needed to tell a slow micromamba from a reclaimed VM was being produced and thrown away:
# on 2026-11-06 a subtype run sat silent for 32 minutes inside a 70-minute budget with no
# way to know which it was. Same defect as the swallowed poll failure below -- silence
# meaning two things. tee: the terminal sees it live, `captured` still proves it worked.
captured=""; captured_rc=0
stream() {                       # stream <client seconds> <command...>
    local secs="$1" tmp; shift
    tmp="$(mktemp "${TMPDIR:-/tmp}/polyphar-colab.XXXXXX")"
    captured_rc=0
    # `|| captured_rc=$?`: under `set -e` + `pipefail` a timeout here would end the script
    # on the spot, and the caller's diagnostic -- the whole reason the step is checked --
    # would never print. A 3 s budget exited silently until this was added.
    timeout --foreground "$secs" "$@" 2>&1 | tr -d '\000' | tee "$tmp" \
        | sed 's/^/           /' || captured_rc=$?
    captured="$(cat "$tmp")"
    rm -f "$tmp"
    return 0
}

# `timeout` reports 124 when it had to kill the client. Saying so turns "it did not work"
# into "we stopped waiting", which is a different thing to go and look at.
gave_up() { [ "$captured_rc" = 124 ] && printf ' after %ss (COLAB_%s_TIMEOUT)' "$1" "$2"; return 0; }

# the remote cell gets a little less than the client, so a cell that overruns reports
# itself rather than being cut off at the socket with nothing to show for it
cell_timeout() {
    local margin=$(( $1 / 10 ))
    [ "$margin" -lt 5 ] && margin=5
    [ "$margin" -gt 600 ] && margin=600
    local n=$(( $1 - margin ))
    [ "$n" -lt 5 ] && n=5
    printf '%s' "$n"
    return 0
}

# Pushover from the HOST, for the phases of the round trip the worker cannot report:
# the worker only exists between launch and finish, so upload, merge and any failure
# before or after it would otherwise reach nobody.
push() {
    local title="$1" msg="$2" prio="${3:-0}"
    [ -f "$home_dir/pushover.env" ] || return 0
    local tok usr
    tok="$(sed -n 's/^PUSHOVER_APP_TOKEN=//p' "$home_dir/pushover.env" | tr -d "'\"" )"
    usr="$(sed -n 's/^PUSHOVER_USER_KEY=//p' "$home_dir/pushover.env" | tr -d "'\"" )"
    [ -n "$tok" ] && [ -n "$usr" ] || return 0
    curl -s --max-time 20 -F "token=$tok" -F "user=$usr" -F "priority=$prio" \
         -F "title=[$(basename "$run_dir")] $title" -F "message=$msg" \
         https://api.pushover.net/1/messages.json >/dev/null 2>&1 || true
}
die() { printf 'polyphar-colab: %s\n' "$*" >&2; push "dock failed" "$*" 1; exit 1; }

# Every unit this host already holds, as `<label>/r<i>` -- the same id fetch.py reads from
# /content/have.txt. Derived from the bundle each time: no bookkeeping file to go stale.
local_units() {
    [ -d "$bundle/results" ] || return 0
    ( cd "$bundle/results" && ls -d */replicates/*.done 2>/dev/null ) \
        | sed 's#/replicates/#/#; s#\.done$##'
}
local_count() { local_units | wc -l | tr -d ' '; }

# Pull the units the VM has and this host does not. THE point of the exercise: a unit on
# POSEIDON's disk cannot be lost to a reclaimed VM, so a lost session costs one interval
# rather than everything drawn since it started.
#
# Returns non-zero on any failure WITHOUT losing anything: selection is recomputed from
# this host's own tree next time, so a dropped upload, exec, download or extraction is
# simply retried. Never call die() from here -- a failed pull must not end the run.
fetch() {
    local force="${1:-}" manifest out n tgz_out before
    manifest="$(mktemp -t polyphar-have-XXXXXX.txt)"
    local_units > "$manifest" 2>/dev/null || true
    if ! timeout --foreground 300 colab upload "$manifest" /content/have.txt -s "$session" >/dev/null 2>&1; then
        rm -f "$manifest"; note "           fetch: manifest upload failed; retrying next poll"; return 1
    fi
    rm -f "$manifest"
    if ! out="$(timeout --foreground 900 colab exec -f "$repo/bin/colab/fetch.py" \
                    ${force:+--env FETCH_FORCE=1} --timeout 600 -s "$session" 2>&1 | tr -d '\000')"; then
        note "           fetch: exec failed; retrying next poll"; return 1
    fi
    n="$(printf '%s\n' "$out" | sed -n 's/^FETCH units=\([0-9]*\).*/\1/p' | head -1)"
    if [ -z "$n" ]; then
        note "           fetch: no FETCH line (${out##*$'\n'}); retrying next poll"; return 1
    fi
    [ "$n" = 0 ] && return 0
    tgz_out="$(mktemp -t polyphar-outbox-XXXXXX.tgz)"
    if ! timeout --foreground 3600 colab download /content/outbox.tgz "$tgz_out" -s "$session" >/dev/null 2>&1; then
        rm -f "$tgz_out"; note "           fetch: download failed; retrying next poll"; return 1
    fi
    before="$(local_count)"
    # straight into the bundle: tar extraction is additive per file, and fetch.py puts each
    # unit's .done marker last so an interrupted extract cannot certify a missing record
    if ! tar xzf "$tgz_out" -C "$bundle"; then
        rm -f "$tgz_out"; note "           fetch: the archive did not extract; retrying next poll"; return 1
    fi
    rm -f "$tgz_out"
    note "           pulled $n unit(s); $before -> $(local_count) held here"
    return 0
}

command -v colab >/dev/null 2>&1 || die "the colab CLI is not on PATH (pip install google-colab-cli)"
[ -d "$run_dir" ] || die "run dir $run_dir does not exist"
[ -d "$repo/bin/colab" ] || die "$repo/bin/colab not found; set POLYPHAR_REPO"

# The image tag: polyphar-docker defaults to `latest`, which does not exist on this
# machine, and the failure is a docker "pull access denied" that says nothing about the
# real cause. Check it here, where the message can name the fix.
tag="${POLYPHAR_VERSION:-latest}"
if ! docker image inspect "polyphar:$tag" >/dev/null 2>&1; then
    die "docker image polyphar:$tag not found.
     Set the tag before running, as §0 of the runbook does:
         export POLYPHAR_VERSION=1.1
     Available: $(docker images --format '{{.Repository}}:{{.Tag}}' polyphar 2>/dev/null | tr '\n' ' ')"
fi

commit="$(cd "$repo" && git rev-parse HEAD)"
if ! (cd "$repo" && git diff --quiet HEAD -- polyphar); then
    die "the polyphar package has uncommitted changes. The worker installs polyphar from
     the commit you pin, so the GPU would run different code than this host planned.
     Commit and push first."
fi

# --- 1. export ------------------------------------------------------------------------
# A second bundle exported before the first is merged contains the SAME units: both get
# worked and the second merge's draws are discarded, with the GPU time already spent.
export_root="$run_dir/07_docking/export"
[ -n "$control" ] && export_root="$run_dir/08_control/docking/export"
# An unmerged bundle is either a run still working on Colab (this wrapper lost its
# terminal, the detached worker did not) or one whose merge failed. Re-running RE-ATTACHES
# to the first: if the session is alive and holds this very bundle, skip straight to
# polling, then pack, download and merge as usual. Nothing is re-exported or re-uploaded.
attach=""
merge_only=""
fetch_every="${COLAB_FETCH_EVERY:-1}"
max_fails="${COLAB_MAX_POLL_FAILS:-10}"
session_lost=""
fetch_tick=0
unmerged=()
if [ -d "$export_root" ]; then
    for b in "$export_root"/*/; do
        [ -d "$b" ] || continue
        if [ -f "$b/units.tsv" ] && [ ! -f "$b/.merged" ]; then unmerged+=("${b%/}"); fi
    done
fi
if [ "${#unmerged[@]}" -gt 1 ]; then
    die "more than one unmerged bundle under ${export_root#$run_dir/}: ${unmerged[*]##*/}.
     Merge or delete all but one before re-running."
fi
if [ "${#unmerged[@]}" = 1 ]; then
    b="${unmerged[0]}"
    brel="${b#$run_dir/}"
    remote=""
    if colab sessions 2>/dev/null | grep -q "^\[$session\]"; then
        remote="$(timeout --foreground 180 colab exec -f "$repo/bin/colab/bundle_id.py" --timeout 60 -s "$session" 2>&1 \
                  | tr -d '\000' | sed -n 's/^BUNDLE_ID=//p' | head -1)"
    fi
    local_id="$(sha256sum "$b/run_key.json" 2>/dev/null | cut -d' ' -f1)"
    if [ -n "$remote" ] && [ "$remote" = "$local_id" ]; then
        attach=1
        bundle="$b"; rel="$brel"; name="${b##*/}"
        n_units="$(( $(wc -l < "$bundle/units.tsv") - 1 ))"
        say "re-attaching to bundle $rel on Colab session '$session' (nothing re-exported)"
        push "dock: re-attached" "Polling bundle $name again on session $session."
    elif [ -d "$b/results" ] && [ -n "$(ls -A "$b/results" 2>/dev/null)" ]; then
        # Since the pull became incremental this is the ORDINARY state after any
        # interruption: units were pulled, the session is gone, the merge never ran.
        # Refusing here would strand real results behind a manual command.
        merge_only=1
        bundle="$b"; rel="$brel"; name="${b##*/}"
        say "session '$session' is gone, but $(local_count) pulled unit(s) are here: merging them"
        push "dock: merging what was pulled" "Session gone; merging $(local_count) unit(s) already home."
    else
        die "bundle $brel is unmerged and Colab session '$session' does not hold it
     (session gone, or a different bundle${remote:+: $remote}). If you used another
     session name, re-run with --session NAME. If the VM is really gone its work is lost:
     delete the bundle and re-run; export re-plans only what is still outstanding."
    fi
fi

tgz=""
if [ -z "$attach" ] && [ -z "$merge_only" ]; then
    name="$(date +%Y%m%dT%H%M%S)"
    rel="${export_root#$run_dir/}/$name"
    say "dock-export -> $rel"
    "$here/polyphar-docker" dock-export --bundle "$rel" $control \
        ${library:+--library "$library"} \
        ${max_units:+--max-units "$max_units"} --engine-version 'Uni-Dock 1.2.0'

    bundle="$export_root/$name"
    [ -f "$bundle/units.tsv" ] || die "export wrote no units.tsv"
    n_units="$(( $(wc -l < "$bundle/units.tsv") - 1 ))"
    [ "$n_units" -gt 0 ] || { say "nothing outstanding; removing the empty bundle"; rm -rf "$bundle"; exit 0; }
    say "$n_units unit(s) to work"
    push "dock: exported $n_units units" "Bundle $name ready; uploading to Colab ($gpu)."

    tgz="$(mktemp -t polyphar-bundle-XXXXXX.tgz)"
    tar czf "$tgz" -C "$export_root" "$name"

    # --- 2. session -----------------------------------------------------------------------
    if colab sessions 2>/dev/null | grep -q "^\[$session\]"; then
        say "reusing Colab session '$session'"
    else
        say "creating Colab session '$session' on a $gpu"
        colab new -s "$session" --gpu "$gpu"
    fi

    say "uploading bundle ($(du -h "$tgz" | cut -f1))"
    timeout --foreground 3600 colab upload "$tgz" /content/bundle.tgz -s "$session"
    if [ -f "$home_dir/pushover.env" ]; then
        timeout --foreground 300 colab upload "$home_dir/pushover.env" /content/pushover.env -s "$session"
    else
        say "WARNING: $home_dir/pushover.env not found; launch will refuse unless ALLOW_SILENT=1"
    fi

    # --- 3. run ---------------------------------------------------------------------------
    say "installing the engine (pinned to $commit)"
    # same reason as the launch below: the exit status says the cell ran, not that it
    # worked, so setup.py's own last line is the proof
    stream "$setup_s" colab exec -f "$repo/bin/colab/setup.py" \
        --env "POLYPHAR_COMMIT=$commit" --timeout "$(cell_timeout "$setup_s")" -s "$session"
    case "$captured" in
        *"setup: ready"*) ;;
        *) die "the engine did not install on the VM$(gave_up "$setup_s" SETUP) (see
     above). The bundle is at $rel and nothing was lost; fix the cause and re-run." ;;
    esac

    push "dock: worker starting" "$n_units units on a $gpu. Progress every ${poll_s}s."
    say "launching the detached worker"
    # `colab exec` exits 0 even when the script it ran raised: the cell executed, which is
    # all the CLI reports. Trusting it meant a refused launch (no Pushover credentials, a
    # worker already running, a bundle missing a file) looked like success -- the wrapper
    # then polled a worker that was never started, saw NO-PIDFILE at once, merged zero
    # units and said "done". So the proof of launch is launch.py's own last line.
    stream "$launch_s" colab exec -f "$repo/bin/colab/launch.py" \
        --timeout "$(cell_timeout "$launch_s")" -s "$session" \
        ${ALLOW_SILENT:+--env "ALLOW_SILENT=$ALLOW_SILENT"}
    case "$captured" in
        *"worker pid="*RUNNING*) ;;
        *) die "the worker did not start$(gave_up "$launch_s" LAUNCH) (see the message
     above). Nothing was lost: the bundle is at $rel and the units are still
     outstanding." ;;
    esac
fi

if [ -n "$merge_only" ]; then
    say "nothing to poll: merging the units already pulled"
else
say "polling every ${poll_s}s (the poll is also the keep-alive)"
# Every poll prints a line, including a failed one. Swallowing the failure and grepping
# for ^STATE= made a dropped websocket look exactly like a quiet worker: on 2026-11-04 a
# healthy run showed nothing in the terminal for 14 minutes while two polls silently
# failed. Silence must mean one thing, so it is now reserved for "the wrapper is dead".
# `timeout --foreground`: without it timeout moves colab into its own process group and
# Ctrl+C in the terminal never reaches it (nor stops the wrapper). colab exec's own
# --timeout bounds the remote cell, not the client. On
# 2026-11-04 a poll client hung on a lost websocket for 8 hours with --timeout 120, and
# the loop -- and the keep-alive -- stopped with it while the worker docked on unwatched.
fails=0
while true; do
    sleep "$poll_s"
    # tr -d '\000': the exec output can carry a null byte, and bash then warns
    # "command substitution: ignored null byte in input" on every single poll
    if out="$(timeout --foreground 300 colab exec -f "$repo/bin/colab/poll.py" --timeout 120 -s "$session" 2>&1 | tr -d '\000')"; then
        line="$(printf '%s\n' "$out" | grep -m1 -E '^STATE=' || true)"
        if [ -n "$line" ]; then
            fails=0
            note "$line"
            # the worker's own progress, so the terminal shows ligands as well as units
            # the LAST progress line: the poll tails ~3 kB of the log, oldest first, so the
            # first match was the run's first line and showed "1%" on every poll
            printf '%s\n' "$out" | grep -E 'dock-worker: [0-9]+/[0-9]+ units' | tail -1 \
                | sed 's/^/           /' || true
            # The incremental pull. poll.py already prints done=<n>/<total>, so when the
            # VM has nothing this host lacks we spend no upload, no exec and no download
            # -- which is every poll but the few where a unit actually lands.
            remote_done="$(printf '%s\n' "$line" | sed -n 's/.*done=\([0-9]*\)\/.*/\1/p')"
            fetch_tick=$((fetch_tick + 1))
            if [ -n "$remote_done" ] && [ "$remote_done" = "$(local_count)" ]; then
                :
            elif [ "$((fetch_tick % fetch_every))" = 0 ]; then
                fetch || true
            fi
        else
            fails=$((fails + 1))
            note "poll returned no STATE line (attempt $fails); worker is detached and unaffected"
        fi
    else
        fails=$((fails + 1))
        note "poll FAILED (attempt $fails): ${out##*$'\n'}"
        note "           the worker is detached, so this is the connection, not the job"
        if [ "$fails" = 6 ]; then
            push "dock: cannot reach the GPU host" \
                 "6 consecutive polls failed. The worker may still be running; check with
colab download /content/worker.log /tmp/w.log -s $session" 1
        fi
        # Without this the loop polls a dead session for ever. It used to be harmless
        # because nothing had been pulled anyway; now that every poll brings results
        # home, giving up and merging what is here is the right end to a lost VM.
        if [ "$fails" -ge "$max_fails" ]; then
            note "giving up after $fails consecutive failed polls; merging what is here"
            push "dock: session lost" \
                 "$fails polls failed in a row. Merging the $(local_count) unit(s) already pulled." 1
            session_lost=1
            break
        fi
    fi
    case "$out" in
        *STATE=GONE*|*STATE=NO-PIDFILE*) break ;;
    esac
done
fi

# --- 4. bring it home -----------------------------------------------------------------
# Most of the results are already here, pulled poll by poll. This is the last sweep: the
# units finished since the final poll, plus worker.json and the worker's own failed.tsv
# and log, which the per-poll pulls also carry but which are only complete now.
if [ -n "$session_lost" ]; then
    merge_only=1
    say "the session is gone: merging the $(local_count) unit(s) that were pulled"
fi
if [ -z "$merge_only" ]; then
    push "dock: worker finished" "Fetching the last results and merging."
    say "final fetch"
    ok=""
    for try in 1 2 3; do
        if fetch force; then ok=1; break; fi
        note "final fetch attempt $try failed; retrying"
    done
    [ -n "$ok" ] || die "the final fetch failed three times. Everything pulled so far is
     at $rel/results and is NOT lost: re-run to retry the fetch and the merge."
fi

say "dock-merge ($(local_count) unit(s) held here)"
merge_rc=0
"$here/polyphar-docker" dock-merge --bundle "$rel" $control \
    ${library:+--library "$library"} || merge_rc=$?

# exit 3 is `incomplete_targets`, which is the NORMAL state until the last bundle lands:
# this run merged its units and others remain outstanding. Treating it as failure would
# make every intermediate round trip look broken and break `&&` chains. Anything else is
# a real failure and the bundle is left unmerged so it can be retried.
case "$merge_rc" in
    0) touch "$bundle/.merged" ;;
    3) touch "$bundle/.merged"; say "merged; work still outstanding (exit 3 from dock-merge)" ;;
    *) die "dock-merge failed (exit $merge_rc). The bundle is kept at $rel; results are in
     $bundle/results. Fix the cause and re-run `polyphar-docker dock-merge --bundle $rel`." ;;
esac

[ -n "$keep" ] || [ -n "$merge_only" ] || colab stop -s "$session" || true
rm -f ${tgz:+"$tgz"}

push "dock: merged" "Bundle $name merged into the run folder. Re-run \`polyphar dock\` until nothing is outstanding."
say "done: bundle $rel merged. Re-run until dock reports nothing outstanding."
