#!/usr/bin/env python3
"""Stand-in for the DoGSiteScorer binary (tests and local end-to-end runs only).

    fake_dogsite -p <model> [other flags...] -o <out>

Writes <out>.pml first (a partial output, as the real binary writes several files),
then <out>_res_P_1.pdb and finally <out>_desc.txt. The pocket is one of several REAL
net2 pockets of different proteins in fake_dogsite_data/ (<label>.res_P_1.pdb with its
real descriptor row <label>.desc.txt, all drugScore >= 0.5), chosen deterministically
from the sha256 of the model's file name, so different models get different pockets.

  * exits 3 when the model's file name contains FAIL
  * sleeps $FAKE_DOGSITE_SLEEP seconds (after writing <out>.pml), when set
  * appends the model path to $FAKE_DOGSITE_LOG, when set (one line per call)
"""
import hashlib
import os
import shutil
import sys
import time

DATA = os.path.join(os.path.dirname(os.path.realpath(__file__)), "fake_dogsite_data")


def _value(flag):
    args = sys.argv[1:]
    if flag not in args or args.index(flag) + 1 >= len(args):
        sys.exit(f"fake_dogsite: missing {flag} <path>")
    return args[args.index(flag) + 1]


def pocket_label(model):
    labels = sorted(f[:-len(".desc.txt")] for f in os.listdir(DATA) if f.endswith(".desc.txt"))
    digest = hashlib.sha256(os.path.basename(model).encode()).hexdigest()
    return labels[int(digest, 16) % len(labels)]


def main():
    model, out = _value("-p"), _value("-o")
    log = os.environ.get("FAKE_DOGSITE_LOG")
    if log:
        fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        try:
            os.write(fd, (model + "\n").encode())
        finally:
            os.close(fd)
    if "FAIL" in os.path.basename(model):
        print(f"fake_dogsite: FAIL requested by model name {model}", file=sys.stderr)
        return 3
    if not os.path.isfile(model):
        print(f"fake_dogsite: no such model {model}", file=sys.stderr)
        return 2
    label = pocket_label(model)
    with open(out + ".pml", "w") as fh:
        fh.write(f"# fake_dogsite pocket {label}\n")
    if os.environ.get("FAKE_DOGSITE_SLEEP"):
        time.sleep(float(os.environ["FAKE_DOGSITE_SLEEP"]))
    shutil.copyfile(os.path.join(DATA, label + ".res_P_1.pdb"), out + "_res_P_1.pdb")
    shutil.copyfile(os.path.join(DATA, label + ".desc.txt"), out + "_desc.txt")
    print(f"fake_dogsite: pocket {label} for {model}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
