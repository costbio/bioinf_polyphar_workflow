#!/usr/bin/env python3
"""Stand-in for the DoGSiteScorer 2 / DoGSite3 binaries (tests and local end-to-end runs only).

    fake_dogsite -p <model> [other flags...] -o <out>

The mode follows the flags, as polyphar-dogsite-worker passes them:
  dogsite3 (--writeSiteResiduesPDB given): takes the pocket NAMES and the descriptor of
      one REAL DoGSite3 1.3.0 output set from fake_dogsite3_data/<label>/, renamed to
      <out>_desc.txt and <out>_P_..._res.pdb; the residue files are written first and
      <out>_desc.txt last. Every label has pockets on both sides of volume 300 A^3.
  dogsite2 (otherwise): writes <out>.pml first (a partial output), then
      <out>_res_P_1.pdb and finally <out>_desc.txt, the descriptor row of one of several
      REAL net2 pockets in fake_dogsite_data/ (all drugScore >= 0.5).
The descriptor label is chosen deterministically from the sha256 of the model's file name,
so different models get different numbers.

The pocket RESIDUES are cut from the model itself (`carve`), not copied from the fixture.
A pocket must lie inside its own receptor: a pocket from another protein is the exact
defect that docked 9 of 37 net1 targets into empty space, and `check_box_occupancy` now
refuses it -- a fake that produced only mispaired pockets could never have caught it.

  * --help prints a DoGSite3-like usage text (no version, lists --writeSiteResiduesPDB), or,
    when invoked as fake_dogsite2 (symlink), a DoGSiteScorer 2-like one; exits 0
  * exits 3 when the model's file name contains FAIL
  * sleeps $FAKE_DOGSITE_SLEEP seconds (after the first partial output), when set
  * appends the model path to $FAKE_DOGSITE_LOG, when set (one line per call)
  * appends the full argument list to $FAKE_DOGSITE_ARGS_LOG, when set
"""
import hashlib
import os
import shutil
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
DATA = os.path.join(HERE, "fake_dogsite_data")
DATA3 = os.path.join(HERE, "fake_dogsite3_data")


def _value(flag):
    args = sys.argv[1:]
    if flag not in args or args.index(flag) + 1 >= len(args):
        sys.exit(f"fake_dogsite: missing {flag} <path>")
    return args[args.index(flag) + 1]


def _pick(labels, model):
    digest = hashlib.sha256(os.path.basename(model).encode()).hexdigest()
    return sorted(labels)[int(digest, 16) % len(labels)]


def pocket_label(model):
    return _pick([f[:-len(".desc.txt")] for f in os.listdir(DATA) if f.endswith(".desc.txt")],
                 model)


def _append(path, text):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, text.encode())
    finally:
        os.close(fd)


def _residues(model):
    """[(key, [ATOM lines])] of the model, in file order."""
    out, index = [], {}
    with open(model, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if not line.startswith("ATOM"):
                continue
            key = line[21:27]
            if key not in index:
                index[key] = len(out)
                out.append((key, []))
            out[index[key]][1].append(line)
    return out


def carve(model, out_pdb, want=14, salt=""):
    """Write a pocket made of the MODEL'S OWN residues.

    The fake used to copy a real pocket of a DIFFERENT protein. That made every target it
    produced a pocket/receptor mismatch, so an end-to-end run through it could never have
    caught the defect that docked 9 of 37 net1 targets into empty space -- in that test
    world the bad case was the only case. It also now trips `geometry.check_box_occupancy`,
    which refuses a box the receptor does not occupy. A pocket cut from the model is both
    faithful and inside its own receptor.

    The residue window is chosen deterministically from the output name, so two pockets of
    one model differ and a rerun reproduces them.
    """
    res = _residues(model)
    if not res:
        raise SystemExit(f"fake_dogsite: {model} has no ATOM records to carve a pocket from")
    start = int(hashlib.sha256((os.path.basename(out_pdb) + salt).encode()).hexdigest(), 16)
    start %= len(res)
    lines = []
    for i in range(min(want, len(res))):
        lines.extend(res[(start + i) % len(res)][1])
    with open(out_pdb, "w", encoding="utf-8") as fh:
        fh.write("HEADER File contains complete residues of binding site atoms\n")
        fh.writelines(lines)
        fh.write("END\n")


def _sleep():
    if os.environ.get("FAKE_DOGSITE_SLEEP"):
        time.sleep(float(os.environ["FAKE_DOGSITE_SLEEP"]))


def dogsite3(model, out):
    label = _pick([d for d in os.listdir(DATA3) if os.path.isdir(os.path.join(DATA3, d))], model)
    src = os.path.join(DATA3, label)
    res = sorted(f for f in os.listdir(src) if f.endswith("_res.pdb"))
    for i, name in enumerate(res):
        # the NAMES come from the fixture set (so pocket numbering stays realistic); the
        # CONTENTS are cut from this model, so the pocket is inside its own receptor
        carve(model, out + name[len(label):], salt=name)
        if i == 0:
            _sleep()
    shutil.copyfile(os.path.join(src, label + "_desc.txt"), out + "_desc.txt")
    print(f"fake_dogsite: dogsite3 pockets of {label} for {model}")


def dogsite2(model, out):
    label = pocket_label(model)
    with open(out + ".pml", "w") as fh:
        fh.write(f"# fake_dogsite pocket {label}\n")
    _sleep()
    carve(model, out + "_res_P_1.pdb")
    shutil.copyfile(os.path.join(DATA, label + ".desc.txt"), out + "_desc.txt")
    print(f"fake_dogsite: pocket {label} for {model}")


def main():
    if "--help" in sys.argv[1:] or "-h" in sys.argv[1:]:
        if "dogsite2" in os.path.basename(sys.argv[0]):   # tests/fixtures/fake_dogsite2
            print(" Available options:\n  -i [ --druggability ]   Calculate (sub)pocket "
                  "druggability.\n  -a [ --pocAlgorithm ] arg (=0)  DoGSite = 0 (default)")
        else:                                              # like DoGSite3 1.3.0: no version
            print(" License:\n  --license LicenseKey   Activate a new license\n\n"
                  " Input options:\n  -p [ --proteinFile ] arg   Protein input file (fake)\n"
                  " Output options:\n  --writeSiteResiduesPDB   Write pocket site residues")
        return 0
    if os.environ.get("FAKE_DOGSITE_ARGS_LOG"):
        _append(os.environ["FAKE_DOGSITE_ARGS_LOG"], " ".join(sys.argv[1:]) + "\n")
    model, out = _value("-p"), _value("-o")
    if os.environ.get("FAKE_DOGSITE_LOG"):
        _append(os.environ["FAKE_DOGSITE_LOG"], model + "\n")
    if "FAIL" in os.path.basename(model):
        print(f"fake_dogsite: FAIL requested by model name {model}", file=sys.stderr)
        return 3
    if not os.path.isfile(model):
        print(f"fake_dogsite: no such model {model}", file=sys.stderr)
        return 66
    if "--writeSiteResiduesPDB" in sys.argv[1:]:
        dogsite3(model, out)
    else:
        dogsite2(model, out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
